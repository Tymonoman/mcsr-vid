{
  "name": "mcsr-vid",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "fetch-match": "tsx src/fetchMatch.ts",
    "download-vods": "tsx src/downloadVods.ts",
    "validate-sync": "tsx src/validateSync.ts",
    "build-overlay-css": "node scripts/build-overlay-css.mjs",
    "remotion:studio": "npm run build-overlay-css && remotion studio remotion/index.ts",
    "remotion:render": "npm run build-overlay-css && remotion render remotion/index.ts MatchOverlay",
    "render-overlay": "npm run build-overlay-css && tsx src/renderOverlay.ts",
    "generate-thumbnail": "npm run build-overlay-css && tsx src/generateThumbnail.ts",
    "generate-project": "npm run build-overlay-css && tsx src/generateProject.ts",
    "start": "npm run build-overlay-css && tsx src/tui.tsx"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.507",
    "@remotion/cli": "^4.0.507",
    "@remotion/renderer": "^4.0.507",
    "ink": "^7.1.1",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remotion": "^4.0.507"
  }
}
